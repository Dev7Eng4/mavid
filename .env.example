
GPM_API_BASE=http://localhost:9495

# Google OAuth (Drive sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Không đặt GOOGLE_REDIRECT_URI → app quét cổng 59247–59270; thêm TẤT CẢ các URI đó (127.0.0.1) vào Google Cloud, hoặc xem export OAUTH_LOOPBACK_URIS_DOC trong auth.util.js
# Một URI cố định: GOOGLE_REDIRECT_URI=http://127.0.0.1:59247
# GOOGLE_OAUTH_PORT=59247
