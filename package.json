{
  "name": "mavid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "concurrently -k \"vite --port 5173 --strictPort\" \"nodemon --watch electron --ext js,cjs --exec electron .\"",
    "tao-chrome-profile": "node contents/scripts/makeChromeProfile.js",
    "mo-gpm-playwright": "node contents/scripts/openGpmPlaywright.js",
    "lay-thong-tin-youtube (video, channel)": "node -e \"import('./contents/getInfoChannel.js').then(m=>m.default())\"",
    "tao-batch-video-tu-audio": "node -e \"import('./contents/scripts/createBatchVideo.js').then(m => m.default({ videoType: 'from_audio' }))\"",
    "tao-batch-video-reup-full": "node -e \"import('./contents/scripts/createBatchVideo.js').then(m => m.default({ videoType: 'reup_full' }))\"",
    "tao-thumbnail-flow": "node contents/flow/createThumbnail.cli.js",
    "tom-tat-meta-tu-transcript": "node contents/scripts/summaryMetaFromTranscript.js",
    "syncProgressToSpreadsheet": "node contents/scripts/syncProgressToSpreadsheet.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.2.2",
    "concurrently": "9.2.1",
    "electron": "41.1.1",
    "exceljs": "4.4.0",
    "glob": "13.0.6",
    "inquirer": "13.3.2",
    "playwright": "1.59.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.5",
    "sql.js": "^1.14.1",
    "tailwindcss": "4.2.2",
    "xlsx": "0.18.5",
    "youtube-dl-exec": "3.1.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.59.1",
    "@rolldown/plugin-babel": "0.2.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "nodemon": "3.1.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.0.1"
  }
}
