[
  {
    "id": 1,
    "text": "冷蔵庫の中に豆腐は入っていますか?"
  },
  {
    "id": 2,
    "text": "安くて美味しくてそして何より減る"
  },
  {
    "id": 3,
    "text": "しやっこ"
  },
  {
    "id": 4,
    "text": "にお味噌汁マーボ豆腐私たちの食卓に"
  },
  {
    "id": 5,
    "text": "欠かすことのできないまさに国民食ですよ"
  },
  {
    "id": 6,
    "text": "ね。"
  },
  {
    "id": 7,
    "text": "畑のお肉とも呼ばれ健康のために毎日"
  },
  {
    "id": 8,
    "text": "欠かさず食べているという方も多いのでは"
  },
  {
    "id": 9,
    "text": "ないでしょうか。"
  },
  {
    "id": 10,
    "text": "しかし、もしあなたが家族の健康を思って"
  },
  {
    "id": 11,
    "text": "よかれと思って毎日続けているその食べ方"
  },
  {
    "id": 12,
    "text": "が、"
  },
  {
    "id": 13,
    "text": "実は豆腐の素晴らしい健康効果を全て"
  },
  {
    "id": 14,
    "text": "台無しにするどころか、あなたの体を静か"
  },
  {
    "id": 15,
    "text": "にそして確実に蝕ばんでいるとしたら、"
  },
  {
    "id": 16,
    "text": "その食べ方実は毒かもしれません。"
  },
  {
    "id": 17,
    "text": "信じがいかもしれませんが、これは決して"
  },
  {
    "id": 18,
    "text": "大げさな話ではありません。"
  },
  {
    "id": 19,
    "text": "食べ方1つで豆腐は最高の薬にもなれば"
  },
  {
    "id": 20,
    "text": "最悪の毒にもなりるのです。"
  },
  {
    "id": 21,
    "text": "あなたがいつもやっている醤油のかけ方、"
  },
  {
    "id": 22,
    "text": "あなたがいつも選んでいる豆腐の種類、"
  },
  {
    "id": 23,
    "text": "その何気ない無意識の習慣があなたの健康"
  },
  {
    "id": 24,
    "text": "寿命を少しずつ縮めているのかもしれない"
  },
  {
    "id": 25,
    "text": "のです。"
  },
  {
    "id": 26,
    "text": "今回の動画ではあまりにも身近すぎるが"
  },
  {
    "id": 27,
    "text": "ゆえに誰もが信じて疑わない豆腐に"
  },
  {
    "id": 28,
    "text": "まつわる古い常識に科学のメスを入れて"
  },
  {
    "id": 29,
    "text": "いきます。"
  },
  {
    "id": 30,
    "text": "あなたの豆腐の常識はもう古いかも。"
  },
  {
    "id": 31,
    "text": "なぜあなたがいつもやっている味噌汁の"
  },
  {
    "id": 32,
    "text": "作り方が豆腐の最強成分をドブに捨てて"
  },
  {
    "id": 33,
    "text": "いるのと同じなのか。"
  },
  {
    "id": 34,
    "text": "なぜあなたがいつも捨てているパックの水"
  },
  {
    "id": 35,
    "text": "に健康を外する罠が潜んでいるのか。"
  },
  {
    "id": 36,
    "text": "そして動画の後半ではスーパーの片隅に"
  },
  {
    "id": 37,
    "text": "ひっそりと置かれているあの地味な見た目"
  },
  {
    "id": 38,
    "text": "の茶色い豆腐。"
  },
  {
    "id": 39,
    "text": "そう荒野豆腐がなぜ普通の豆腐の何倍もの"
  },
  {
    "id": 40,
    "text": "栄養化を誇る奇跡の豆腐とまで呼ばれるの"
  },
  {
    "id": 41,
    "text": "か。"
  },
  {
    "id": 42,
    "text": "その秘密を徹底的に解き明かしていきます"
  },
  {
    "id": 43,
    "text": "。"
  },
  {
    "id": 44,
    "text": "この動画はあなたの長年の豆腐の常識を"
  },
  {
    "id": 45,
    "text": "根底から覆す知識のアップデートです。"
  },
  {
    "id": 46,
    "text": "今回の話を知らずに明日からも同じ食べ方"
  },
  {
    "id": 47,
    "text": "を続けることはあまりにも危険です。"
  },
  {
    "id": 48,
    "text": "どうか最後までご自身の常識と"
  },
  {
    "id": 49,
    "text": "照らし合わせながらご覧ください。"
  },
  {
    "id": 50,
    "text": "このチャンネルでは55歳以上の皆さんに"
  },
  {
    "id": 51,
    "text": "向けて健康寿命を伸ばすヒントや暮らしに"
  },
  {
    "id": 52,
    "text": "役立つ情報をお届けしています。"
  },
  {
    "id": 53,
    "text": "今後の最新情報を見逃さないためにも是非"
  },
  {
    "id": 54,
    "text": "チャンネル登録をお願いします。"
  },
  {
    "id": 55,
    "text": "さてまず皆さんに直面していただくのは"
  },
  {
    "id": 56,
    "text": "あなた自身が普段無意識にあるいはよかれ"
  },
  {
    "id": 57,
    "text": "と思ってやってしまっている豆腐の貴重な"
  },
  {
    "id": 58,
    "text": "栄養を自らの手で葬り去っている最悪の"
  },
  {
    "id": 59,
    "text": "習慣です。"
  },
  {
    "id": 60,
    "text": "今回は特に罪深く、そして多くの方がやっ"
  },
  {
    "id": 61,
    "text": "てしまっているワースト5号をランキング"
  },
  {
    "id": 62,
    "text": "形式で発表します。"
  },
  {
    "id": 63,
    "text": "ご自身の食べ方を思い浮かべながら厳しく"
  },
  {
    "id": 64,
    "text": "チェックしてみてください。"
  },
  {
    "id": 65,
    "text": "まずワースト第5位。"
  },
  {
    "id": 66,
    "text": "日ややっこに醤油をドバドバかける。"
  },
  {
    "id": 67,
    "text": "これはやってしまいますよね。"
  },
  {
    "id": 68,
    "text": "特に暑い夏の日、金キ金キンに冷えた"
  },
  {
    "id": 69,
    "text": "日やっこに役身を載せて醤油を一回し"
  },
  {
    "id": 70,
    "text": "2回し"
  },
  {
    "id": 71,
    "text": "日本人で良かったと心から思える瞬間です"
  },
  {
    "id": 72,
    "text": "。"
  },
  {
    "id": 73,
    "text": "しかしその人回しがあなたの健康を静かに"
  },
  {
    "id": 74,
    "text": "脅かしているとしたら"
  },
  {
    "id": 75,
    "text": "問題は言うまでもなく塩分の取り過ぎです"
  },
  {
    "id": 76,
    "text": "。"
  },
  {
    "id": 77,
    "text": "豆腐はそれ自体が非常にタパな味わいです"
  },
  {
    "id": 78,
    "text": "。"
  },
  {
    "id": 79,
    "text": "だからこそつい醤油をかけすぎてしまい"
  },
  {
    "id": 80,
    "text": "がち。"
  },
  {
    "id": 81,
    "text": "大さじ一杯の醤油には約2.6gもの塩分"
  },
  {
    "id": 82,
    "text": "が含まれています。"
  },
  {
    "id": 83,
    "text": "厚生労働省が推奨する1日の塩分接取目標"
  },
  {
    "id": 84,
    "text": "量は男性で7.5g未満、女性で6.5g"
  },
  {
    "id": 85,
    "text": "未満。"
  },
  {
    "id": 86,
    "text": "高血圧の治療をしている方に至ってはなん"
  },
  {
    "id": 87,
    "text": "と6g未満です。"
  },
  {
    "id": 88,
    "text": "冷やっこに醤油ドバッとかけてさらに塩分"
  },
  {
    "id": 89,
    "text": "の多いお味噌汁や漬け物を一緒に食べたと"
  },
  {
    "id": 90,
    "text": "すれば"
  },
  {
    "id": 91,
    "text": "たった1食で1日の目標量に限りなく"
  },
  {
    "id": 92,
    "text": "近づいてしまうということも決して珍しく"
  },
  {
    "id": 93,
    "text": "ありません。"
  },
  {
    "id": 94,
    "text": "塩分の取り過ぎは高血圧を招き、"
  },
  {
    "id": 95,
    "text": "やがて動脈効果を進行させ、"
  },
  {
    "id": 96,
    "text": "真金梗速や脳梗速といった命に関わる病気"
  },
  {
    "id": 97,
    "text": "の引き金となります。"
  },
  {
    "id": 98,
    "text": "せっかく健康に良い豆腐を食べているのに"
  },
  {
    "id": 99,
    "text": "その食べ方で病気のリスクを高めてしまっ"
  },
  {
    "id": 100,
    "text": "ては本末点灯ですよね。"
  },
  {
    "id": 101,
    "text": "醤油はかけるのではなくつける。"
  },
  {
    "id": 102,
    "text": "小皿にほんの少しだけ醤油を出し豆腐を"
  },
  {
    "id": 103,
    "text": "ちょんとつけて食べる。"
  },
  {
    "id": 104,
    "text": "あるいは醤油の代わりにポン酢や脱子醤油"
  },
  {
    "id": 105,
    "text": "原醤油を使う。"
  },
  {
    "id": 106,
    "text": "このほんの少しの工夫があなたの10年後"
  },
  {
    "id": 107,
    "text": "の血管の健康を守ります。"
  },
  {
    "id": 108,
    "text": "続いてワースト第4位。"
  },
  {
    "id": 109,
    "text": "これも大好きな方が多い定番料理に潜む罠"
  },
  {
    "id": 110,
    "text": "です。"
  },
  {
    "id": 111,
    "text": "マーボ豆腐など油っこい料理で食べる。"
  },
  {
    "id": 112,
    "text": "美味しいですよね。マーボー豆腐。"
  },
  {
    "id": 113,
    "text": "白いご飯との相性はまさに悪魔です。"
  },
  {
    "id": 114,
    "text": "しかしその美味しさと引き換えにあなたは"
  },
  {
    "id": 115,
    "text": "豆腐の健康効果を全て長消しにしているか"
  },
  {
    "id": 116,
    "text": "もしれません。"
  },
  {
    "id": 117,
    "text": "問題は調理に使われる大量の油と糖質です"
  },
  {
    "id": 118,
    "text": "。"
  },
  {
    "id": 119,
    "text": "挽き肉を炒めるためのごま油やラー油。"
  },
  {
    "id": 120,
    "text": "そして味付けに使われる豆城や天面には"
  },
  {
    "id": 121,
    "text": "多くの砂糖が含まれています。"
  },
  {
    "id": 122,
    "text": "糖質と脂質の組み合わせは最も太りやすく"
  },
  {
    "id": 123,
    "text": "、"
  },
  {
    "id": 124,
    "text": "そして最も体を廊下させる最悪の"
  },
  {
    "id": 125,
    "text": "組み合わせなのです。"
  },
  {
    "id": 126,
    "text": "この2つが体の中で結びつくとエージス"
  },
  {
    "id": 127,
    "text": "週末等下物と呼ばれる強力な廊下物質が"
  },
  {
    "id": 128,
    "text": "大量に発生します。"
  },
  {
    "id": 129,
    "text": "このエジスは血管の壁にこびりついて弾力"
  },
  {
    "id": 130,
    "text": "を失わせ動脈効果を引き起こしたり"
  },
  {
    "id": 131,
    "text": "肌のコラーゲンを破壊してシミやシワの"
  },
  {
    "id": 132,
    "text": "原因になったり"
  },
  {
    "id": 133,
    "text": "さらには骨をもろくしたり認知症の原因に"
  },
  {
    "id": 134,
    "text": "までなると言われているまさに廊下促進剤"
  },
  {
    "id": 135,
    "text": "なのです。"
  },
  {
    "id": 136,
    "text": "豆腐自体は低カロリーでヘルシーな食材"
  },
  {
    "id": 137,
    "text": "です。"
  },
  {
    "id": 138,
    "text": "しかし、それを大量の油と砂糖で"
  },
  {
    "id": 139,
    "text": "コーティングしてしまっては、もはやそれ"
  },
  {
    "id": 140,
    "text": "は健康食品とは呼べません。"
  },
  {
    "id": 141,
    "text": "豆腐を食べているから大丈夫という安心感"
  },
  {
    "id": 142,
    "text": "が最も危険なのです。"
  },
  {
    "id": 143,
    "text": "続いてワースト第3位。"
  },
  {
    "id": 144,
    "text": "これはスーパーでの何気ない選択に潜む"
  },
  {
    "id": 145,
    "text": "大きな落とし穴です。"
  },
  {
    "id": 146,
    "text": "ひ越しを選ぶいかがですか?"
  },
  {
    "id": 147,
    "text": "喉越しがつるンとしていて好きだから"
  },
  {
    "id": 148,
    "text": "なんとなく高級感があるから。"
  },
  {
    "id": 149,
    "text": "そんな理由で無意識にキ越し豆腐ばかり手"
  },
  {
    "id": 150,
    "text": "に取っていませんか?"
  },
  {
    "id": 151,
    "text": "もちろんキ越し豆腐が悪いわけではあり"
  },
  {
    "id": 152,
    "text": "ません。"
  },
  {
    "id": 153,
    "text": "しかし、もしあなたが健康のために豆腐を"
  },
  {
    "id": 154,
    "text": "食べているのであれば、その選択は非常に"
  },
  {
    "id": 155,
    "text": "もったいないと言わざるを得ません。"
  },
  {
    "id": 156,
    "text": "なぜなら私たちが本当に取るべき重要な"
  },
  {
    "id": 157,
    "text": "栄養素のほとんどはキ越し豆腐ではなく、"
  },
  {
    "id": 158,
    "text": "モメ豆腐の方に圧倒的に多く含まれている"
  },
  {
    "id": 159,
    "text": "からです。"
  },
  {
    "id": 160,
    "text": "取るべき栄養はめにあり、"
  },
  {
    "id": 161,
    "text": "例えば骨を強くするカルシウムはも面の方"
  },
  {
    "id": 162,
    "text": "が約3倍。"
  },
  {
    "id": 163,
    "text": "血液を作る鉄分は約2.4倍。"
  },
  {
    "id": 164,
    "text": "そして筋肉の元となるタンパク質も"
  },
  {
    "id": 165,
    "text": "約1.3倍も多いのです。"
  },
  {
    "id": 166,
    "text": "なぜこんなにも差がつくのか。"
  },
  {
    "id": 167,
    "text": "それは作り方の違いにあります。"
  },
  {
    "id": 168,
    "text": "ひ越し豆腐が豆乳をそのまま固めるのに"
  },
  {
    "id": 169,
    "text": "対して"
  },
  {
    "id": 170,
    "text": "モめオフは1度固めたものを崩し布を敷い"
  },
  {
    "id": 171,
    "text": "た肩に入れおしを乗せて水分を絞りながら"
  },
  {
    "id": 172,
    "text": "作ります。"
  },
  {
    "id": 173,
    "text": "この水分を絞るという工程で栄養がギュっ"
  },
  {
    "id": 174,
    "text": "と凝縮されるのです。"
  },
  {
    "id": 175,
    "text": "喉越しの良さと引き換えに、あなたは最も"
  },
  {
    "id": 176,
    "text": "大切な栄養素をミスミス逃してしまってい"
  },
  {
    "id": 177,
    "text": "た。"
  },
  {
    "id": 178,
    "text": "これからは是非積極的にモトオフを選ぶ"
  },
  {
    "id": 179,
    "text": "ようにしてください。"
  },
  {
    "id": 180,
    "text": "そしてワースト第2。"
  },
  {
    "id": 181,
    "text": "これは99%の人がよかれと思って、"
  },
  {
    "id": 182,
    "text": "あるいは無意識にやってしまっている。"
  },
  {
    "id": 183,
    "text": "衛星的に非常に危険な習慣です。"
  },
  {
    "id": 184,
    "text": "の水、重点水を捨てずに使う豆腐のパック"
  },
  {
    "id": 185,
    "text": "を開けるとひたヒタと水が入っていますよ"
  },
  {
    "id": 186,
    "text": "ね。"
  },
  {
    "id": 187,
    "text": "あの水どうしていますか?"
  },
  {
    "id": 188,
    "text": "豆腐の栄養が溶け出していそうだからその"
  },
  {
    "id": 189,
    "text": "まま味噌汁に入れている。"
  },
  {
    "id": 190,
    "text": "そんな方いませんか?今すぐやめて"
  },
  {
    "id": 191,
    "text": "ください。"
  },
  {
    "id": 192,
    "text": "あの水は絶対に料理に使ってはいけません"
  },
  {
    "id": 193,
    "text": "。"
  },
  {
    "id": 194,
    "text": "あの水は重点水、重点水と呼ばれ頭の形が"
  },
  {
    "id": 195,
    "text": "崩れるのを防ぎ、乾燥から守るためのただ"
  },
  {
    "id": 196,
    "text": "の水です。"
  },
  {
    "id": 197,
    "text": "しかしこの水の中には豆腐から溶け出した"
  },
  {
    "id": 198,
    "text": "苦や恵ぐの原因となる成分や"
  },
  {
    "id": 199,
    "text": "そして何よりも雑菌が繁殖している可能性"
  },
  {
    "id": 200,
    "text": "があるのです。"
  },
  {
    "id": 201,
    "text": "バックの水は紙成分プラス雑菌。"
  },
  {
    "id": 202,
    "text": "豆腐は水分が非常に多い食品ですから痛み"
  },
  {
    "id": 203,
    "text": "やすい。"
  },
  {
    "id": 204,
    "text": "パックの中で時間が経つにつれて雑菌が"
  },
  {
    "id": 205,
    "text": "少しずつ増えていきます。"
  },
  {
    "id": 206,
    "text": "その水をそのまま料理に使ってしまうと"
  },
  {
    "id": 207,
